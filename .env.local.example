# GAMA Photo Capture - Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase Configuration (shared with GAMA ERP)
# Get these from: https://supabase.com/dashboard/project/ljbkjtaowrdddvjhsygj/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://ljbkjtaowrdddvjhsygj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Application URL (for OAuth redirects)
# Development: http://localhost:3001
# Production: https://photos.gama.co.id
NEXT_PUBLIC_APP_URL=http://localhost:3001
